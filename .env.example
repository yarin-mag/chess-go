# Clerk publishable key (Clerk dashboard -> your application -> API Keys -> Publishable key)
VITE_CLERK_PUBLISHABLE_KEY=

# Base URL of the deployed b-chess-server (Task 6)
VITE_API_BASE_URL=http://127.0.0.1:8787

# Dev only (`npm run dev`/`dev:web`, never a real build): set to 1 to skip Clerk entirely and act as a
# fixed fake signed-in test account. Useful for opening the app from a second device (e.g. a phone over
# LAN) where Clerk's dev-instance OAuth redirect (bound to localhost) can never resolve. Leave unset.
VITE_DEV_SKIP_AUTH=
